# 复制成 .env 后填入你自己的访问口令
#   cp .env.example .env
# 建议 16 位以上随机串：openssl rand -base64 24
DLOG_TOKEN=change-me-to-a-long-random-string

# 宿主机上的 Docker data-root（不是容器内路径），用于 volumes 挂载。
# 默认值 /var/lib/docker 覆盖标准安装；改过 data-root 的机器在这里写上真实路径。
# 不确定可以先不管——启动后页面会通过 docker socket 问出真实路径并给出提示。
DLOG_DATA_ROOT=/var/lib/docker
